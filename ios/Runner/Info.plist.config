<!-- iOS Permissions Configuration -->
<!-- File: ios/Runner/Info.plist -->
<!-- Add the following keys to the plist dictionary -->

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Camera permissions - for gait test video recording -->
	<key>NSCameraUsageDescription</key>
	<string>JointSaathi needs camera access to record gait analysis videos for accurate OA risk assessment.</string>

	<!-- Motion/Accelerometer permissions -->
	<key>NSMotionUsageDescription</key>
	<string>JointSaathi uses device motion data (accelerometer and gyroscope) to analyze your gait for OA screening.</string>

	<!-- Bluetooth permissions - for wearable device integration -->
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>JointSaathi can connect to Bluetooth wearables for enhanced gait analysis and sensor data.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>JointSaathi uses Bluetooth to sync with wearable health devices for continuous monitoring.</string>

	<!-- Location permissions - for regional health data tracking -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>JointSaathi uses your location to identify health clinics and map high-risk OA areas in your region.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>JointSaathi uses location data to provide localized health resources and track regional OA trends.</string>

	<!-- File system permissions - for data export -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>JointSaathi needs access to your photo library to save screening reports and health documents.</string>

	<!-- Health Kit permissions - future integration -->
	<key>NSHealthShareAuthorizationUsageDescription</key>
	<string>JointSaathi can read your health data to provide better OA risk assessment.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>JointSaathi can save your screening results to Health app for unified health tracking.</string>

	<!-- Microphone - for voice notes in screenings (optional) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>JointSaathi uses microphone to record voice notes during patient screenings.</string>

	<!-- Background App Refresh -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<!-- Required capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>accelerometer</string>
		<string>gyroscope</string>
		<string>bluetooth-le</string>
	</array>

	<!-- Minimum iOS version -->
	<key>MinimumOSVersion</key>
	<string>12.0</string>

</dict>
</plist>
