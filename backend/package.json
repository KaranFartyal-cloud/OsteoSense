{
  "name": "jointsaathi-backend",
  "version": "1.0.0",
  "description": "JointSaathi - AI-assisted Osteoarthritis risk screening backend for rural health camps in NER India (Smart India Hackathon - MDoNER)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed.js",
